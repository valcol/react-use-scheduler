{
  "name": "react-use-scheduler",
  "version": "2.0.0",
  "description": "A React hook that allows you to schedule tasks and automatically orchestrate them based on your component lifecycle and visibility.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "jest",
    "lint": "eslint src __tests__",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "swc src/index.js -o dist/index.cjs -C module.type=commonjs",
    "build:esm": "swc src/index.js -o dist/index.mjs -C module.type=es6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valcol/react-use-scheduler.git"
  },
  "keywords": [
    "react",
    "hook",
    "scheduler",
    "scheduling",
    "fid",
    "inp",
    "postTask"
  ],
  "author": "valcol",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/valcol/react-use-scheduler/issues"
  },
  "homepage": "https://github.com/valcol/react-use-scheduler#readme",
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.3.24",
    "@swc/jest": "^0.2.24",
    "@testing-library/react": "^13.4.0",
    "eslint": "^8.27.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jest": "^27.1.4",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.3.1",
    "jest-environment-jsdom": "^29.3.0",
    "prettier": "^2.7.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "react-intersection-observer": "^9.4.0"
  }
}
